# MongoDB (user accounts) — defaults to mongodb://localhost:27017 if unset:
MONGODB_URI=mongodb://localhost:27017

# Lyzr Manager Agent (required for live orchestration; demo falls back locally)
LYZR_API_KEY=your-lyzr-api-key
LYZR_AGENT_ID=your-lyzr-agent-id
LYZR_USER_ID=aegismind-user

# Optional specialized Lyzr workers (defaults to LYZR_AGENT_ID)
# LYZR_COMMITMENT_AGENT_ID=
# LYZR_CONFLICT_AGENT_ID=
# LYZR_DECISION_AGENT_ID=
# LYZR_RECALL_AGENT_ID=

# Optional: push answers back to the Omi app
# OMI_APP_ID=
# OMI_APP_SECRET=

# Qdrant — leave unset for embedded local storage (./qdrant_data),
# or point at a server / Qdrant Cloud URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data
QDRANT_COLLECTION=voice_memory
